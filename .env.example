# Copy to .env (never commit .env). All values below are local-development placeholders.

# PostgreSQL connection string (server-only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alvoxis_flow

# Separate database used by integration tests. Tests TRUNCATE tables in this database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/alvoxis_flow_test

# Public base URL of the application (used for absolute links, PWA, emails later).
APP_URL=http://localhost:3000

# Log verbosity: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Authentication (Stage 2) -------------------------------------------------------------
# Secret for signing sessions and encrypting 2FA secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates all sessions and makes stored 2FA secrets unreadable.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google sign-in (optional). Leave empty to hide the Google button. See docs/auth/AUTHENTICATION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery: disabled | file | smtp
#   disabled: nothing is sent; the UI explains that email is not configured
#   file:     development/tests only — messages are written to EMAIL_FILE_DIR
#   smtp:     real delivery through an SMTP provider
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=tmp/mail
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Only when running behind a trusted reverse proxy: header carrying the client IP.
TRUSTED_IP_HEADER=
