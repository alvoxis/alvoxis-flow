{
  "name": "alvoxis-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ALVOXIS Flow — business management SaaS for SMBs in Latvia, Lithuania, Estonia and Poland",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-permissions.ts",
    "db:test-data": "tsx --require ./scripts/support/server-only-shim.cjs scripts/seed-test-data.ts",
    "db:studio": "drizzle-kit studio",
    "auth:reset-2fa": "tsx --require ./scripts/support/server-only-shim.cjs scripts/reset-two-factor.ts",
    "auth:reencrypt-2fa": "tsx --require ./scripts/support/server-only-shim.cjs scripts/reencrypt-two-factor.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "docs:samples": "tsx scripts/render-sample-documents.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.9.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  }
}
